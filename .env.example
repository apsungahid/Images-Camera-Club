# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3001
SITE_URL=http://localhost:3001
# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me
DB_PATH=data/club.db

# Optional: Google sign-in (Google Cloud Console > APIs & Services > Credentials > OAuth client)
# Callback URL: ${SITE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
