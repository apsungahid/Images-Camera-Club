[Unit]
Description=Images Camera Club website
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=photoclub
Group=photoclub
WorkingDirectory=/srv/photoclub
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=3001
Environment=TZ=Asia/Manila
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/srv/photoclub/data /srv/photoclub-backups
ProtectHome=true
PrivateTmp=true
# Leave room for the HRIS on the shared 1 GB server.
MemoryMax=350M

[Install]
WantedBy=multi-user.target
