<div class="auth">
  <%- include('../partials/auth-art') %>
  <section class="auth-panel">
    <div class="auth-card">
      <p class="eyebrow">Members</p>
      <h1>Sign in</h1>
      <% if (error) { %><div class="alert alert-error" role="alert"><%= error %></div><% } %>
      <form class="form" method="post" action="/login">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field">
          <label for="username">Username</label>
          <input id="username" name="username" type="text" autocomplete="username" autocapitalize="none" spellcheck="false" required value="<%= username %>">
        </div>
        <div class="field">
          <label for="password">Password</label>
          <input id="password" name="password" type="password" autocomplete="current-password" required>
        </div>
        <button class="btn btn-block" type="submit">Sign in</button>
      </form>
      <% if (googleEnabled) { %>
        <div class="divider">or</div>
        <%- include('../partials/google-button', { href: '/auth/google', label: 'Continue with Google' }) %>
      <% } %>
      <div class="auth-foot">
        <span>New member? <a href="/join">Join with your invite code</a></span>
        <span>Forgot your password? Ask a club administrator for a reset code, then <a href="/reset">reset it here</a>.</span>
      </div>
    </div>
  </section>
</div>
