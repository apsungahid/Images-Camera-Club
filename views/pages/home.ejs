<section class="hero">
  <div class="hero-media<%= site.heroImage ? '' : ' empty' %>"<% if (site.heroImage) { %> style="background-image:url('<%= site.heroImage %>')"<% } %>></div>
  <div class="hero-content wrap">
    <p class="eyebrow"><%= site.fullName %></p>
    <h1>The island, seen <em>through our lenses.</em></h1>
    <p class="lede">A community of Cebu photographers who walk, shoot, learn and exhibit together. From first cameras to seasoned professionals, we share one habit: looking closely.</p>
    <div class="hero-actions">
      <a class="btn btn-light" href="/gallery">View the gallery</a>
      <a class="btn btn-ghost" href="/events">Upcoming activities</a>
    </div>
  </div>
  <% if (site.heroImage && site.heroCredit) { %><p class="hero-credit"><%= site.heroCredit %></p><% } %>
</section>

<section class="section">
  <div class="wrap">
    <div class="intro">
      <div>
        <p class="eyebrow">The club</p>
        <h2>Made by photographers, for photographers.</h2>
      </div>
      <div>
        <p class="lede">We meet to make pictures and to talk about them honestly. Members join photo walks around the island, learn from workshops and critiques, and test themselves in our internal contests and exhibits.</p>
        <a href="/about">More about the club &rarr;</a>
        <div class="stats">
          <% if (memberCount >= 10) { %><div class="stat"><strong><%= memberCount %></strong><span>Members</span></div><% } %>
          <div class="stat"><strong>Cebu</strong><span>Home base</span></div>
          <div class="stat"><strong>Monthly</strong><span>Photo walks</span></div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="pillars">
      <div class="pillar"><span class="num">i.</span><h3>Photo walks</h3><p>Early mornings in the old city, coastlines at golden hour, festivals in the streets: we go out and shoot together.</p></div>
      <div class="pillar"><span class="num">ii.</span><h3>Workshops &amp; critique</h3><p>Hands-on sessions on light, composition and editing, and friendly, honest reviews of each other's work.</p></div>
      <div class="pillar"><span class="num">iii.</span><h3>Contests &amp; exhibits</h3><p>Themed internal contests through the year, and exhibits that bring our members' best photographs to the public.</p></div>
    </div>
  </div>
</section>

<% if (featured.length) { %>
<section class="section">
  <div class="wrap">
    <div class="section-head">
      <div><p class="eyebrow">Featured work</p><h2>Recent photographs</h2></div>
      <a class="btn btn-ghost" href="/gallery">Full gallery</a>
    </div>
    <div class="masonry">
      <% featured.forEach((p) => { %><%- include('../partials/photo', { p }) %><% }) %>
    </div>
  </div>
</section>
<% } %>

<section class="section dark-band">
  <div class="wrap">
    <div class="section-head">
      <div><p class="eyebrow">Schedule</p><h2>Upcoming activities</h2></div>
      <a class="btn btn-ghost" href="/events">All activities</a>
    </div>
    <% if (events.length) { %>
      <ul class="event-list"><% events.forEach((ev) => { %><%- include('../partials/event', { ev, showDesc: false }) %><% }) %></ul>
    <% } else { %>
      <p class="muted">The next activities will be announced soon.<% if (!user) { %> Members can sign in to see the full schedule.<% } %></p>
    <% } %>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="section-head">
      <div><p class="eyebrow">News</p><h2>From the club</h2></div>
      <a class="btn btn-ghost" href="/announcements">All news</a>
    </div>
    <% if (announcements.length) { %>
      <div class="notes">
        <% announcements.forEach((a) => { %>
          <article class="note">
            <span class="date"><%= fmt.postedOn(a.published_at) %><% if (a.visibility === 'members') { %> · Members<% } %></span>
            <h3><a href="/announcements/<%= a.id %>"><%= a.title %></a></h3>
            <p class="excerpt"><%= a.body %></p>
          </article>
        <% }) %>
      </div>
    <% } else { %>
      <p class="muted">News from the club will appear here.</p>
    <% } %>
  </div>
</section>

<% if (!user) { %>
<section class="section band-soft">
  <div class="wrap cta">
    <p class="eyebrow">Membership</p>
    <h2>Shoot with us.</h2>
    <p class="lede">Members get the full activity schedule, club announcements and a place to show their work. Already received an invite code from the club?</p>
    <div class="hero-actions center">
      <a class="btn" href="/join">Join with an invite code</a>
      <a class="btn btn-ghost" href="/about#membership">How to become a member</a>
    </div>
  </div>
</section>
<% } %>
