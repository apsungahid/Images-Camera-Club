<section class="hero">
  <div class="hero-media<%= site.heroImage ? '' : ' empty' %>"<% if (site.heroImage) { %> style="background-image:url('<%= site.heroImage %>')"<% } %>></div>
  <div class="hero-content wrap">
    <p class="eyebrow"><%= c.hero_eyebrow %></p>
    <h1><%- md.inline(c.hero_title) %></h1>
    <p class="lede"><%- md.inline(c.hero_text) %></p>
    <div class="hero-actions">
      <a class="btn btn-light" href="/gallery">View the gallery</a>
      <a class="btn btn-ghost" href="/events">Upcoming activities</a>
    </div>
  </div>
  <% if (site.heroImage && site.heroCredit) { %><p class="hero-credit"><%= site.heroCredit %></p><% } %>
</section>

<section class="section">
  <div class="wrap">
    <div class="intro">
      <div>
        <p class="eyebrow">The club</p>
        <h2><%- md.inline(c.intro_title) %></h2>
      </div>
      <div>
        <div class="lede"><%- md.blocks(c.intro_text) %></div>
        <a href="/about">More about the club &rarr;</a>
        <div class="stats">
          <% if (memberCount >= 10) { %><div class="stat"><strong><%= memberCount %></strong><span>Members</span></div><% } %>
          <div class="stat"><strong>Cebu</strong><span>Home base</span></div>
          <div class="stat"><strong>Monthly</strong><span>Photo walks</span></div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="pillars">
      <% [['i.', c.pillar1_title, c.pillar1_text], ['ii.', c.pillar2_title, c.pillar2_text], ['iii.', c.pillar3_title, c.pillar3_text]].forEach(([n, h, t]) => { %>
        <div class="pillar"><span class="num"><%= n %></span><h3><%- md.inline(h) %></h3><p><%- md.inline(t) %></p></div>
      <% }) %>
    </div>
  </div>
</section>

<% if (featured.length) { %>
<section class="section">
  <div class="wrap">
    <div class="section-head">
      <div><p class="eyebrow">Featured work</p><h2>Recent photographs</h2></div>
      <a class="btn btn-ghost" href="/gallery">Full gallery</a>
    </div>
    <div class="masonry">
      <% featured.forEach((p) => { %><%- include('../partials/photo', { p }) %><% }) %>
    </div>
  </div>
</section>
<% } %>

<section class="section dark-band">
  <div class="wrap">
    <div class="section-head">
      <div><p class="eyebrow">Schedule</p><h2>Upcoming activities</h2></div>
      <a class="btn btn-ghost" href="/events">All activities</a>
    </div>
    <% if (events.length) { %>
      <ul class="event-list"><% events.forEach((ev) => { %><%- include('../partials/event', { ev, showDesc: false }) %><% }) %></ul>
    <% } else { %>
      <p class="muted">The next activities will be announced soon.<% if (!user) { %> Members can sign in to see the full schedule.<% } %></p>
    <% } %>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="section-head">
      <div><p class="eyebrow">News</p><h2>From the club</h2></div>
      <a class="btn btn-ghost" href="/announcements">All news</a>
    </div>
    <% if (announcements.length) { %>
      <div class="notes">
        <% announcements.forEach((a) => { %>
          <article class="note">
            <span class="date"><%= fmt.postedOn(a.published_at) %><% if (a.visibility === 'members') { %> · Members<% } %></span>
            <h3><a href="/announcements/<%= a.id %>"><%= a.title %></a></h3>
            <p class="excerpt"><%= a.body %></p>
          </article>
        <% }) %>
      </div>
    <% } else { %>
      <p class="muted">News from the club will appear here.</p>
    <% } %>
  </div>
</section>

<% if (!user) { %>
<section class="section band-soft">
  <div class="wrap cta">
    <p class="eyebrow">Membership</p>
    <h2><%- md.inline(c.cta_title) %></h2>
    <p class="lede"><%- md.inline(c.cta_text) %></p>
    <div class="hero-actions center">
      <a class="btn" href="/join">Join with an invite code</a>
      <a class="btn btn-ghost" href="/about#membership">How to become a member</a>
    </div>
  </div>
</section>
<% } %>
