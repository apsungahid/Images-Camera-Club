<% if (catalogues.length) { %>
  <section class="catalogues" aria-label="Gallery categories">
    <div class="catalogue-track" data-slider>
      <% catalogues.forEach((c) => { %>
        <a class="catalogue protect" href="/gallery/<%= c.slug %>">
          <span class="catalogue-img" style="background-image:url('/media/<%= c.cover_key %>')" role="img" aria-label="<%= c.name %>"></span>
          <span class="catalogue-text">
            <span class="catalogue-count"><%= c.photo_count %> photograph<%= c.photo_count === 1 ? '' : 's' %></span>
            <span class="catalogue-name"><%= c.name %></span>
          </span>
        </a>
      <% }) %>
    </div>
    <% if (catalogues.length > 3) { %>
      <div class="slider-controls">
        <button class="slider-btn" type="button" data-slide="-1" aria-label="Previous categories"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M15 5l-7 7 7 7"/></svg></button>
        <button class="slider-btn" type="button" data-slide="1" aria-label="Next categories"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 5l7 7-7 7"/></svg></button>
      </div>
    <% } %>
  </section>
<% } else { %>
  <section class="gallery-empty">
    <div class="wrap center-text">
      <p class="eyebrow">Gallery</p>
      <h1>The gallery is being curated</h1>
      <p class="lede center-block">Our members' photographs will be published here soon. Please check back.</p>
    </div>
  </section>
<% } %>
