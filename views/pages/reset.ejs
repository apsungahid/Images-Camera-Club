<div class="auth">
  <%- include('../partials/auth-art') %>
  <section class="auth-panel">
    <div class="auth-card">
      <p class="eyebrow">Members</p>
      <h1>Reset your password</h1>
      <p class="muted">Enter the reset code a club administrator gave you and choose a new password.</p>
      <% if (error) { %><div class="alert alert-error" role="alert"><%= error %></div><% } %>
      <form class="form" method="post" action="/reset">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field">
          <label for="code">Reset code</label>
          <input class="input-code" id="code" name="code" type="text" placeholder="RST-XXXX-XXXX" autocomplete="off" spellcheck="false" required value="<%= code %>">
        </div>
        <div class="field">
          <label for="password">New password</label>
          <input id="password" name="password" type="password" autocomplete="new-password" minlength="10" required>
          <span class="hint">At least 10 characters.</span>
        </div>
        <div class="field">
          <label for="password_confirm">Confirm new password</label>
          <input id="password_confirm" name="password_confirm" type="password" autocomplete="new-password" minlength="10" required>
        </div>
        <button class="btn btn-block" type="submit">Change password</button>
      </form>
      <div class="auth-foot"><span><a href="/login">Back to sign in</a></span></div>
    </div>
  </section>
</div>
