<div class="wrap admin">
  <%- include('_nav') %>
  <div class="admin-main stack">
    <div>
      <p class="eyebrow">Administration</p>
      <h1>Members<%= year ? ` in ${year}` : '' %></h1>
      <p class="muted"><%= members.length %> <%= members.length === 1 ? 'person' : 'people' %><%= year ? ` were members in ${year}` : ' on the roster' %>. Open a member to record the years they were in the club.</p>
    </div>

    <% if (resetCode) { %>
      <div class="code-reveal" role="status">
        <span class="label">Password reset code for <%= resetCode.name %></span>
        <span class="code"><%= resetCode.code %></span>
        <span class="muted small">Copy it now: it will not be shown again. Valid for 2 days, once.</span>
      </div>
    <% } %>

    <div class="toolbar">
      <form class="inline-form" method="get" action="/admin/members">
        <label class="label" for="year-filter">Show</label>
        <select id="year-filter" name="year" data-autosubmit>
          <option value="">Everyone</option>
          <% const years = new Set([currentYear, ...knownYears.map((k) => k.year)]); [...years].sort((a, b) => b - a).forEach((y) => { const k = knownYears.find((x) => x.year === y); %>
            <option value="<%= y %>" <%= year === y ? 'selected' : '' %>>Members in <%= y %><%= k ? ` (${k.n})` : '' %></option>
          <% }) %>
        </select>
        <noscript><button class="btn btn-ghost btn-sm" type="submit">Show</button></noscript>
      </form>
      <form class="inline-form" method="post" action="/admin/members/years/bulk" data-confirm="Mark everyone with an active website account as a member in the chosen year?">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <select name="year" aria-label="Year">
          <% for (let y = currentYear + 1; y >= currentYear - 1; y -= 1) { %><option value="<%= y %>" <%= y === currentYear ? 'selected' : '' %>><%= y %></option><% } %>
        </select>
        <button class="btn btn-ghost btn-sm" type="submit">Mark all active accounts</button>
      </form>
    </div>

    <details class="panel">
      <summary>Add someone to the roster</summary>
      <p class="muted small">For past members, or members who will not use the website yet. They cannot sign in until you create an invite code for them on their page.</p>
      <form class="form" method="post" action="/admin/members">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="row">
          <div class="field"><label for="n-name">Full name</label><input id="n-name" name="display_name" type="text" maxlength="80" required></div>
          <div class="field"><label for="n-years">Member in (years)</label><input id="n-years" name="years" type="text" placeholder="e.g. 2015, 2016, 2019"><span class="hint">Separate years with commas or spaces.</span></div>
        </div>
        <div class="row">
          <div class="field"><label for="n-email">Email</label><input id="n-email" name="email" type="email" maxlength="200"></div>
          <div class="field"><label for="n-phone">Phone</label><input id="n-phone" name="phone" type="text" maxlength="40"></div>
        </div>
        <div><button class="btn" type="submit">Add to roster</button></div>
      </form>
    </details>

    <div class="table-wrap">
      <table>
        <thead><tr><th>Name</th><th>Member in</th><th>Website</th><th>Last sign-in</th><th>Role</th></tr></thead>
        <tbody>
          <% if (!members.length) { %><tr><td colspan="5" class="muted"><%= year ? `No one is recorded as a member in ${year} yet.` : 'No members yet.' %></td></tr><% } %>
          <% members.forEach((m) => { %>
            <tr>
              <td><a href="/admin/members/<%= m.id %>"><strong><%= m.display_name %></strong></a><br><span class="muted small"><%= m.username || m.email || '' %></span></td>
              <td class="small year-list"><%= m.years ? m.years : '—' %></td>
              <td class="small">
                <% if (!m.has_login) { %><span class="state">No account</span>
                <% } else { %><%= [m.has_password ? 'Password' : null, m.has_google ? 'Google' : null].filter(Boolean).join(' · ') %><% } %>
              </td>
              <td class="small"><%= m.last_login_at ? fmt.postedOn(m.last_login_at) : '—' %></td>
              <td>
                <span class="state <%= m.role === 'admin' ? 'state-admin' : '' %>"><%= m.role %></span>
                <% if (m.status === 'suspended') { %><span class="state state-suspended">suspended</span><% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
