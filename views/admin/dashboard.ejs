<div class="wrap admin">
  <%- include('_nav') %>
  <div class="admin-main stack">
    <div>
      <p class="eyebrow">Administration</p>
      <h1>Overview</h1>
    </div>
    <div class="cards">
      <a class="card-stat" href="/admin/members"><strong><%= counts.members %></strong><span>Active members</span></a>
      <a class="card-stat" href="/admin/invites"><strong><%= counts.invites %></strong><span>Open invite codes</span></a>
      <a class="card-stat" href="/admin/events"><strong><%= counts.events %></strong><span>Upcoming activities</span></a>
      <a class="card-stat" href="/admin/announcements"><strong><%= counts.announcements %></strong><span>Announcements</span></a>
      <div class="card-stat"><strong><%= counts.photos %></strong><span>Photographs</span></div>
    </div>
    <div class="panel">
      <h2>Getting members on board</h2>
      <p class="muted flush">Create an invite code for each new member in <a href="/admin/invites">Invite codes</a> and send it to them privately (Messenger, SMS). They enter it at <strong>/join</strong>. If a member forgets their password, open <a href="/admin/members">Members</a> and create a reset code for them.</p>
    </div>
  </div>
</div>
