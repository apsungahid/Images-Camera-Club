<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title ? `${title} · ${site.fullName}` : `${site.fullName} · ${site.place}` %></title>
  <meta name="description" content="<%= site.fullName %>: <%= site.tagline %>">
  <meta property="og:title" content="<%= title || site.fullName %>">
  <meta property="og:site_name" content="<%= site.fullName %>">
  <meta name="theme-color" content="#0f0e0c">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <link rel="icon" href="/images/mark.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@400;500;600&display=swap">
  <link rel="stylesheet" href="/css/site.css">
  <script src="/js/site.js" defer></script>
</head>
<body class="<%= bodyClass %>">
  <%- include('partials/header') %>
  <main id="main">
    <% if (flash) { %>
      <div class="flash-bar wrap"><div class="alert alert-<%= flash.type %>" role="status"><%= flash.message %></div></div>
    <% } %>
    <%- body %>
  </main>
  <%- include('partials/footer') %>
</body>
</html>
